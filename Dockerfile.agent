FROM golang:1.22-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /agent ./cmd/agent/

FROM alpine:3.19
RUN apk add --no-cache ca-certificates wireguard-tools iproute2
COPY --from=builder /agent /usr/local/bin/mesnet-agent
EXPOSE 443
CMD ["mesnet-agent"]
